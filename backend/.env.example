# Copy this file to .env and fill in your own values.

# --- Server ---
PORT=4000
NODE_ENV=development
# Where the React frontend runs (used for CORS). Comma-separate several origins.
FRONTEND_URL=http://localhost:8080
# Public URL of this API, used to build file links (photos, CVs). Optional
# locally; set it in production, e.g. https://api.thebestscienceacademy.com
PUBLIC_API_URL=

# --- MySQL (your local database) ---
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=science_academy

# --- Auth ---
# Long random string used to sign login tokens. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me

# --- Email (SMTP via nodemailer) — optional; emails are skipped when unset ---
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=
ADMIN_NOTIFY_EMAIL=
CONTACT_NOTIFY_EMAIL=
SMTP_TLS_REJECT_UNAUTHORIZED=true

# --- Supabase (only for the one-time data migration script, Step 8) ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
